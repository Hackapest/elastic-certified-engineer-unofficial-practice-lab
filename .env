COMPOSE_PROJECT_NAME=ece

# Elasticsearch and Kibana version (the exam's version)
ES_VERSION=9.3.8

# Password of the `elastic` superuser on both clusters
ELASTIC_PASSWORD=elastic-lab
# Password Kibana uses to connect (built-in `kibana_system` user)
KIBANA_SYSTEM_PASSWORD=kibana-lab

# JVM heap per Elasticsearch node
ES_HEAP=1g

# Host ports (bound to localhost only)
ES_A_PORT=9200
ES_B_PORT=9201
KIBANA_A_PORT=5601
KIBANA_B_PORT=5602
